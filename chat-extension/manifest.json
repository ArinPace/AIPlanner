{
 "manifest_version":3,
 "name":"AI Planner Chat relay experiment",
 "version":"0.1.0",
 "description":"Relay the isolated Planner Chat tab to a separate ChatGPT Work tab on this computer.",
 "permissions":["storage"],
 "host_permissions":["https://chatgpt.com/*"],
 "background":{"service_worker":"background.js"},
 "content_scripts":[
  {"matches":["https://aiplanner-ten.vercel.app/*"],"js":["planner.js"],"run_at":"document_start"},
  {"matches":["https://chatgpt.com/*"],"js":["chatgpt.js"],"run_at":"document_idle"}
 ]
}
