# Hosted API configuration. Store secrets in Vercel, never in VITE_* variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
BROWSER_USE_API_KEY=
CONNECTION_ENCRYPTION_KEY=
CRON_SECRET=
AI_GATEWAY_MODEL=openai/gpt-6-luna
APP_ORIGIN=https://aiplanner-ten.vercel.app
AGENT_ALLOWED_USERS=arin
# AI Gateway uses Vercel OIDC in production; external runners need an API key.
AI_GATEWAY_API_KEY=
# Optional registered Google OAuth application, with the callback below:
# https://aiplanner-ten.vercel.app/api/agent/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional approved hosted OpenAI OAuth application, with the callback below:
# https://aiplanner-ten.vercel.app/api/agent/oauth/callback/openai
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
# Private VM worker settings
# The existing CONNECTION_ENCRYPTION_KEY protects API keys entered in Setup.
# Never reuse Codex CLI's OAuth client for a publicly hosted ChatGPT login.
# Hosted subscription sign-in requires an approved OpenAI client integration.
